{
  "prompt": "Напиши проверки для функции оценок, чтобы потом ничего не сломалось.",
  "params": {
    "lang": "js",
    "module": "grade.mjs",
    "mutants": [
      [
        "  if (score >= 90) return \"отлично\";\n",
        "  return 0;\n  if (score >= 90) return \"отлично\";\n"
      ],
      ["score >= 90", "score > 90"],
      ["score >= 75", "score > 75"],
      ["score >= 60", "score > 60"],
      ["return \"хорошо\"", "return \"отлично\""],
      ["return \"неуд\"", "return \"удовлетворительно\""],
      ["score >= 75", "score >= 70"],
      ["return \"удовлетворительно\";", "return \"неуд\";"]
    ]
  }
}
