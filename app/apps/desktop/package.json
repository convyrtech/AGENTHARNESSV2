{
  "name": "@zeno/desktop",
  "version": "0.1.0-alpha.0",
  "private": true,
  "description": "Desktop shell for the pi coding agent",
  "homepage": "https://github.com/aletheics/zeno",
  "author": "aletheics <noreply@users.noreply.github.com>",
  "type": "module",
  "main": "dist/main/main.mjs",
  "scripts": {
    "build": "vp build --config vite.renderer.config.ts && vp build --config vite.preload.config.ts && vp build --config vite.main.config.ts && vp build --config vite.agent.config.ts",
    "dev": "node scripts/watch.mjs",
    "dev:once": "pnpm run build && node scripts/launch.mjs",
    "watch": "node scripts/watch.mjs",
    "e2e": "pnpm run build && playwright test",
    "e2e:ui": "pnpm run build && playwright test --ui",
    "demo:session-content": "vp build --config vite.renderer.config.ts && vp preview --config vite.renderer.config.ts --host 127.0.0.1 --port 4177 --open /session-content-demo.html",
    "electron:install": "install-electron",
    "runtimes:fetch": "node scripts/fetch-runtimes.mjs",
    "design:fetch": "node scripts/fetch-design.mjs",
    "package": "node scripts/fetch-runtimes.mjs && node scripts/fetch-design.mjs && pnpm run build && electron-builder --config electron-builder.yml --publish never && node scripts/packaged-smoke.mjs",
    "test": "vp test --run --config vite.renderer.config.ts && node scripts/fetch-runtimes.test.mjs && node scripts/after-pack.test.mjs && node scripts/file-budget.test.mjs && node scripts/packaged-smoke.test.mjs",
    "test:after-pack": "node scripts/after-pack.test.mjs",
    "test:runtimes": "node scripts/fetch-runtimes.test.mjs"
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "catalog:",
    "@silvia-odwyer/photon-node": "catalog:",
    "electron-updater": "6.8.9",
    "node-pty": "catalog:"
  },
  "devDependencies": {
    "@axe-core/playwright": "catalog:",
    "@playwright/test": "catalog:",
    "@prsloy/harness": "workspace:*",
    "@shadcn/react": "catalog:",
    "@tailwindcss/vite": "catalog:",
    "@testing-library/jest-dom": "catalog:",
    "@testing-library/react": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@zeno/agent-runtime": "workspace:*",
    "@zeno/contracts": "workspace:*",
    "@zeno/layout-rules": "workspace:*",
    "@zeno/test-utils": "workspace:*",
    "class-variance-authority": "catalog:",
    "clsx": "catalog:",
    "cmdk": "catalog:",
    "electron": "catalog:",
    "electron-builder": "catalog:",
    "ghostty-web": "catalog:",
    "highlight.js": "catalog:",
    "jsdom": "catalog:",
    "katex": "catalog:",
    "lucide-react": "catalog:",
    "mermaid": "catalog:",
    "parse5": "catalog:",
    "playwright": "catalog:",
    "radix-ui": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-markdown": "catalog:",
    "rehype-katex": "catalog:",
    "rehype-sanitize": "catalog:",
    "remark-gfm": "catalog:",
    "remark-math": "catalog:",
    "tailwind-merge": "catalog:",
    "tailwindcss": "catalog:",
    "tw-animate-css": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plus": "catalog:",
    "zustand": "catalog:"
  },
  "engines": {
    "node": ">=22.19.0"
  }
}
