+def chromium_only():
+    """DP_CHROMIUM_ONLY=1: no WebKit on this machine (Windows app); "both" means Chromium, webkit runs on Chromium."""
+    return os.environ.get("DP_CHROMIUM_ONLY", "") not in ("", "0")
+
+
+def launch(pw, engine):
+    """Launch a Playwright browser. DP_BROWSER_CHANNEL (e.g. msedge) picks an installed browser for Chromium."""
+    if engine == "webkit" and chromium_only():
+        engine = "chromium"
+    channel = os.environ.get("DP_BROWSER_CHANNEL") if engine == "chromium" else None
+    return getattr(pw, engine).launch(**({"channel": channel} if channel else {}))
+
+
